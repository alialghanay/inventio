	<parameter name="branchName" class="java.lang.String"/>
	<parameter name="startDate" class="java.util.Date"/>
	<parameter name="endDate" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[SELECT inventio.product.size,
       inventio.storge.brand,
       inventio.sales.branch_name,
       SUM(inventio.cart.qty) AS total_qty
FROM inventio.cart
INNER JOIN inventio.sales ON inventio.cart.sales_id = inventio.sales.sales_id
INNER JOIN inventio.product ON inventio.cart.product_id = inventio.product.pid
INNER JOIN inventio.storge ON inventio.product.bid = inventio.storge.bid
WHERE inventio.sales.state = 'صرف'
	AND
	inventio.sales.branch_name = $P{branchName}
	AND
	inventio.sales.register_date
	BETWEEN
	$P{startDate}
	AND
	$P{endDate}
GROUP BY inventio.product.size, inventio.storge.brand, inventio.sales.branch_name]]>
	</queryString>
