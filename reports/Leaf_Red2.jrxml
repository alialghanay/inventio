	<style name="Detail" fontName="Arial" fontSize="12"/>
	<parameter name="salesId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[5]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT inventio.sales.sales_id,
	inventio.sales.register_date,
	inventio.sales.invoice_id,
	inventio.sales.driver_id,
	inventio.sales.totalqty,
	inventio.sales.branch_name,
	inventio.sales.employee_id,
	inventio.sales.notes,
	inventio.drivers.driver_name,
	inventio.employee.username,
	inventio.cart.cart_id,
	inventio.cart.qty,
	inventio.product.size,
	inventio.storge.brand
FROM inventio.sales
	INNER JOIN inventio.cart ON 
	 inventio.cart.sales_id = inventio.sales.sales_id 
	INNER JOIN inventio.drivers ON 
	 inventio.sales.driver_id = inventio.drivers.driver_id 
	INNER JOIN inventio.employee ON 
	 inventio.sales.employee_id = inventio.employee.employee_id 
	INNER JOIN inventio.product ON 
	 inventio.cart.product_id = inventio.product.pid
	 INNER JOIN inventio.storge ON 
	 inventio.storge.bid = inventio.product.bid
	 WHERE
    sales.sales_id = $P{salesId}]]>
	</queryString>
