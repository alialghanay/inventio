	<queryString language="SQL">
		<![CDATA[SELECT inventio.storge.bid,
	inventio.storge.brand,
	inventio.storge.supplier_name,
	inventio.product.pid,
	inventio.product.size,
	inventio.product.qty,
	inventio.product.register_date,
	inventio.product.qtyEntry
FROM inventio.storge
	INNER JOIN inventio.product ON 
	 inventio.storge.bid = inventio.product.bid]]>
	</queryString>
